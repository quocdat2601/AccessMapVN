{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SupabaseConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Hangfire": {
    "Enabled": false
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 60
  },
  "Notifications": {
    "Firebase": {
      "Enabled": false,
      "ProjectId": "",
      "CredentialPath": "",
      "PollSeconds": 15
    }
  },
  "ObjectStorage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "us-east-1",
    "Bucket": "accessmapvn-media"
  },
  "Supabase": {
    "Url": "https://your-project.supabase.co",
    "Audience": "authenticated"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Wf02": {
    "PolicyVersion": "wf02-v1",
    "Recency": {
      "RecentWindowDays": 30,
      "HalfLifeDays": 180
    },
    "Freshness": {
      "RecheckAfterDays": 90,
      "FactorHalfLifeAfterRecheckDays": 180,
      "BatchSize": 500,
      "Cron": "0 2 * * *"
    },
    "Consensus": {
      "MinIndependentVotersForReview": 2,
      "MaxReputationWeight": 100,
      "CrowdAutoResolveEnabled": false,
      "CrowdMinHighTierVoters": 3,
      "CrowdMinAgreement": 0.9
    },
    "Advisory": {
      "MaxDurationDays": 60
    },
    "Jobs": {
      "MaxAttempts": 3,
      "LeaseSeconds": 300,
      "ReconciliationCron": "* * * * *",
      "Queue": "wf02-community"
    },
    "Votes": {
      "MaxCommentLength": 1500,
      "IdempotencyTtlHours": 24
    },
    "Reputation": {
      "DefaultReputationScore": 0,
      "VoteHoldThreshold": 0,
      "PolicyVersion": "wf02-provisional-v1"
    },
    "FeatureFlags": {
      "ReadModel": true,
      "Vote": true,
      "Report": true,
      "Moderation": true,
      "Comments": true
    }
  },
  "AllowedHosts": "*"
}
