# Public client configuration only. Never put service-role or private keys here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# HTTPS production URLs are used as-is. In local development, the app can infer
# the Metro host for physical devices when these values are omitted.
# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_AI_SERVICE_URL=https://ai.example.com
