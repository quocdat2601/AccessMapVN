# ─────────────────────────────────────────────────────────────────────────────
# AccessMap VN AI Service – environment variable template
# Copy to .env and fill in your values before running locally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── Model paths ───────────────────────────────────────────────────────────────
MODELS_DIR=models
PHOBERT_MODEL_PATH=models/phobert

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
# Leave S3_ENDPOINT_URL empty to use AWS S3; set to MinIO URL for local dev
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-southeast-1
S3_BUCKET=accessmap-media

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://backend:8080
HTTP_TIMEOUT=30.0

# ── Scoring thresholds ────────────────────────────────────────────────────────
SCORE_AUTO_VERIFY=0.80
SCORE_PENDING=0.60
CV_WEIGHT=0.6
NLP_WEIGHT=0.4

# ── CV pipeline ───────────────────────────────────────────────────────────────
YOLO_CONF_THRESHOLD=0.45
YOLO_IMG_SIZE=640
KEYFRAME_FPS=1.0
BLUR_LAPLACIAN_THRESHOLD=80.0

# ── Privacy ───────────────────────────────────────────────────────────────────
FACE_BLUR_KERNEL=51
